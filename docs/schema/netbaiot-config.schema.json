{
  "$defs": {
    "AdminProduct": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "product_id"
      ],
      "type": "object"
    },
    "AdminResourceConfig": {
      "additionalProperties": false,
      "properties": {
        "devices": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DeviceKey"
          },
          "type": "array"
        },
        "products": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AdminProduct"
          },
          "type": "array"
        },
        "tenants": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ApiKeyConfig": {
      "additionalProperties": false,
      "properties": {
        "auth_generation": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "expires_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "global": {
          "default": false,
          "type": "boolean"
        },
        "key_id": {
          "type": "string"
        },
        "resources": {
          "$ref": "#/$defs/AdminResourceConfig",
          "default": {
            "devices": [],
            "products": [],
            "tenants": []
          }
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "secret_env": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "secret_env",
        "subject",
        "scopes"
      ],
      "type": "object"
    },
    "AuthenticatedDevice": {
      "properties": {
        "auth_generation": {
          "default": 1,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "codec_id": {
          "type": "string"
        },
        "codec_version": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "credential_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "device_key": {
          "$ref": "#/$defs/DeviceKey"
        },
        "permissions": {
          "$ref": "#/$defs/Permissions"
        }
      },
      "required": [
        "device_key",
        "credential_version",
        "codec_id",
        "codec_version",
        "permissions"
      ],
      "type": "object"
    },
    "BusinessRole": {
      "enum": [
        "events",
        "auth_control",
        "multiplexed",
        "commands",
        "application"
      ],
      "type": "string"
    },
    "BusinessRpcConfig": {
      "additionalProperties": false,
      "properties": {
        "auth_max_inflight": {
          "default": 128,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "development_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/BusinessRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "development_token_env": {
          "type": [
            "string",
            "null"
          ]
        },
        "experiment_socket_send_buffer_bytes": {
          "default": null,
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "identities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BusinessRpcIdentityConfig"
          },
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/V3Limits",
          "default": {
            "heartbeat_ms": 5000,
            "initial_connection_window_bytes": 4194304,
            "initial_stream_window_bytes": 262144,
            "max_concurrent_streams": 256,
            "max_frame_payload_bytes": 8192
          },
          "description": "Limits for the sole current Business RPC wire format."
        },
        "max_auth_control_offline_ms": {
          "default": 30000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_connections": {
          "default": 8,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "send_ahead": {
          "anyOf": [
            {
              "$ref": "#/$defs/V3SendAhead"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local sender policy, separate from the negotiated V3 receive windows."
        },
        "tls": {
          "anyOf": [
            {
              "$ref": "#/$defs/ManagementTlsFiles"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "BusinessRpcIdentityConfig": {
      "additionalProperties": false,
      "properties": {
        "call_methods": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "certificate_sha256": {
          "type": "string"
        },
        "expires_at_ms": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "global": {
          "default": false,
          "type": "boolean"
        },
        "principal_id": {
          "type": "string"
        },
        "provide_methods": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "provider_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "$ref": "#/$defs/BusinessRole"
        },
        "sink_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tenants": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "certificate_sha256",
        "principal_id",
        "role",
        "provide_methods",
        "call_methods"
      ],
      "type": "object"
    },
    "Credential": {
      "additionalProperties": false,
      "description": "Provisioned high-entropy 256-bit key. Deliberately no Debug implementation.",
      "properties": {
        "credential_id": {
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/AuthenticatedDevice"
        },
        "secret_hex": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-fA-F]{64}$",
          "type": "string",
          "writeOnly": true
        }
      },
      "required": [
        "credential_id",
        "secret_hex",
        "identity"
      ],
      "type": "object"
    },
    "DeviceAuthSource": {
      "enum": [
        "static",
        "http",
        "business_rpc"
      ],
      "type": "string"
    },
    "DeviceKey": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string"
        },
        "product_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "product_id",
        "device_id"
      ],
      "type": "object"
    },
    "EventDeliverySource": {
      "enum": [
        "http",
        "business_rpc",
        "development_audit"
      ],
      "type": "string"
    },
    "JwtConfig": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string"
        },
        "global_roles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "issuer": {
          "type": "string"
        },
        "jwks_url": {
          "type": "string"
        },
        "role_scopes": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "default": {},
          "type": "object"
        },
        "roles_claim": {
          "default": "roles",
          "type": "string"
        },
        "scope_claim": {
          "default": "scope",
          "type": "string"
        },
        "subject_claim": {
          "default": "sub",
          "type": "string"
        },
        "tenant_claim": {
          "default": "tenants",
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "audience",
        "jwks_url"
      ],
      "type": "object"
    },
