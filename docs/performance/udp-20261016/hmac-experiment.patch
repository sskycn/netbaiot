 #[cfg(test)]
 mod cache_tests {
     use super::*;
+
+    #[test]
+    fn cached_hmac_template_matches_fresh_mac_and_rejects_corruption() {
+        for seed in [0, 7, 255] {
+            let key = [seed; 32];
+            let verifier = DeviceVerifier::new(identity(), key);
+            for length in [0, 1, 31, 32, 55, 56, 63, 64, 65, 256, 1200, 65535] {
+                let message = vec![seed.wrapping_add(1); length];
+                let mut fresh = Hmac::<Sha256>::new_from_slice(&key).unwrap();
+                fresh.update(&message);
+                let expected = fresh.finalize().into_bytes();
+                let tag = verifier.sign(&message).unwrap();
+                assert_eq!(tag[..], expected[..]);
+                verifier.verify(&message, &tag).unwrap();
+                verifier.clone().verify(&message, &tag).unwrap();
+                for byte in 0..tag.len() {
+                    let mut invalid = tag;
+                    invalid[byte] ^= 1;
+                    assert!(verifier.verify(&message, &invalid).is_err());
+                }
+                assert!(verifier.verify(&message, &tag[..31]).is_err());
+                assert!(verifier.verify(&message, &[0; 33]).is_err());
+                // Neither signing nor verification can mutate the cached pads.
+                assert_eq!(verifier.sign(&message).unwrap(), tag);
+            }
+        }
+    }
