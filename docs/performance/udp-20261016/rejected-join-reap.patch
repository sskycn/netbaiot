 const PAYLOAD: &[u8] =
     br#"{"schema_version":1,"source_message_id":"udp:42","kind":"heartbeat","data":{"sequence":42}}"#;
+#[tokio::test]
+async fn capacity_reclaims_completed_work_but_never_a_live_owner() {
+    let mut tasks = JoinSet::new();
+    tasks.spawn(std::future::pending());
+    let completed = Arc::new(tokio::sync::Notify::new());
+    let worker_completed = completed.clone();
+    tasks.spawn(async move {
+        worker_completed.notify_one();
+    });
+    completed.notified().await;
+    assert_eq!(tasks.len(), 2);
+    assert!(datagram_capacity(&mut tasks, 2));
+    assert_eq!(tasks.len(), 1);
+    tasks.spawn(std::future::pending());
+    assert!(!datagram_capacity(&mut tasks, 2));
+    assert_eq!(tasks.len(), 2);
+    tasks.abort_all();
+    while tasks.join_next().await.is_some() {}
+    assert!(datagram_capacity(&mut tasks, 2));
+}
