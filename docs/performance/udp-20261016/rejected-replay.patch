+async fn wait_for_reservation(replay: &ReplayCoordinator) {
+    tokio::time::timeout(Duration::from_secs(1), async {
+        while replay.lock().unwrap().pending.is_empty() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+}
