+#[tokio::test]
+async fn cancelled_reservation_restores_capacity_and_committed_expiry() {
+    for existing in [false, true] {
+        let (ingress, _) = fixture(Limits {
+            max_replay_entries: 1,
+            ingress_wait_timeout_ms: 2_000,
+            ..Limits::default()
+        });
+        let replay = Arc::new(ReplayCoordinator::new(ReplayWindow::new(
+            ingress.limits.clone(),
+        )));
+        if existing {
+            accept_and_ack_concurrent(
+                &packet("a", 1, 41, now_ms(), PAYLOAD),
+                &ingress,
+                &replay,
+                |ack| Ok(ack.len()),
+            )
+            .await
+            .unwrap();
+        }
+        let expiry = replay
+            .lock()
+            .unwrap()
+            .entries
+            .values()
+            .next()
+            .map(|entry| entry.expires);
+        let held = ingress.admission.acquire(&auth().device_key, 100).unwrap();
+        let task_ingress = ingress.clone();
+        let task_replay = replay.clone();
+        let pending = tokio::spawn(async move {
+            accept_and_ack_concurrent(
+                &packet("a", 1, 42, now_ms(), PAYLOAD),
+                &task_ingress,
+                &task_replay,
+                |_| panic!("premature ACK"),
+            )
+            .await
+        });
+        wait_for_reservation(&replay).await;
+        {
+            let mut state = replay.lock().unwrap();
+            // Even an expired wall clock must not evict a pending key.
+            state.prune(i64::MAX);
+            assert_eq!(state.entries.len(), 1);
+            assert_eq!(state.devices.values().sum::<usize>(), 1);
+            assert!(state.expirations.is_empty());
+        }
+        assert!(matches!(
+            accept_and_ack_concurrent(
+                &packet("slow", 1, 1, now_ms(), PAYLOAD),
+                &ingress,
+                &replay,
+                |_| panic!("quota ACK")
+            )
+            .await,
+            Err(Error::Overloaded)
+        ));
+        pending.abort();
+        assert!(pending.await.unwrap_err().is_cancelled());
+        {
+            let state = replay.lock().unwrap();
+            assert!(state.pending.is_empty());
+            assert_eq!(state.entries.len(), usize::from(existing));
+            assert_eq!(state.expirations.len(), state.entries.len());
+            assert_eq!(state.devices.values().sum::<usize>(), state.entries.len());
+            assert_eq!(state.tenants.values().sum::<usize>(), state.entries.len());
+            assert_eq!(
+                state.entries.values().next().map(|entry| entry.expires),
+                expiry
+            );
+        }
+        assert_eq!(ingress.admission.waiting(), (0, 0));
+        drop(held);
+        accept_and_ack_concurrent(
+            &packet("a", 1, 42, now_ms(), PAYLOAD),
+            &ingress,
+            &replay,
+            |ack| Ok(ack.len()),
+        )
+        .await
+        .unwrap();
+        assert_eq!(
+            ingress.metrics.get(Metric::EventsAccepted),
+            1 + u64::from(existing)
+        );
+        ingress.events.stop_workers().await.unwrap();
+    }
+}
