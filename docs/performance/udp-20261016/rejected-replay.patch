+// Async entry preserves bounded, cooperative FIFO contention. The state lock
+// only protects synchronous check/poll/commit and permits cancellation cleanup;
+// neither guard is retained while an admission or a same-key owner is pending.
+struct ReplayCoordinator {
+    state: Mutex<ReplayWindow>,
+    enter: tokio::sync::Mutex<()>,
+}
+impl ReplayCoordinator {
+    fn new(window: ReplayWindow) -> Self {
+        Self {
+            state: Mutex::new(window),
+            enter: tokio::sync::Mutex::new(()),
+        }
+    }
+    fn lock(&self) -> std::sync::LockResult<std::sync::MutexGuard<'_, ReplayWindow>> {
+        self.state.lock()
+    }
+}
+
+/// Owns one suspended admission, including its replay capacity. No lock is held
+/// while awaiting ingress; cancellation restores the exact previously committed
+/// window (or removes a new, uncommitted key) and wakes same-key contenders.
+struct ReplayReservation<'a> {
+    owner: &'a Mutex<ReplayWindow>,
+    key: ReplayKey,
+    previous_expiry: Option<i64>,
+    active: bool,
+}
+impl ReplayReservation<'_> {
+    fn release(&self, window: &mut ReplayWindow) {
+        if let Some(expires) = self.previous_expiry {
+            window.expirations.insert(expiry_key(expires, &self.key));
+        } else {
+            window.entries.remove(&self.key);
+            if let Some(count) = window.devices.get_mut(&self.key.0) {
+                *count -= 1;
+                if *count == 0 {
+                    window.devices.remove(&self.key.0);
+                }
+            }
+            if let Some(count) = window.tenants.get_mut(&self.key.0.tenant_id) {
+                *count -= 1;
+                if *count == 0 {
+                    window.tenants.remove(&self.key.0.tenant_id);
+                }
+            }
+        }
+        if let Some(wake) = window.pending.remove(&self.key) {
+            wake.notify_waiters();
+        }
+    }
+}
+impl Drop for ReplayReservation<'_> {
+    fn drop(&mut self) {
+        if self.active
+            && let Ok(mut window) = self.owner.lock()
+        {
+            self.release(&mut window);
+        }
+    }
+}
