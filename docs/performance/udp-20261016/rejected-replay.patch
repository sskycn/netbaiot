+        });
+    }
+    wait_for_reservation(&replay).await;
+    assert_eq!(ingress.metrics.get(Metric::UdpAcksSent), 0);
+    tokio::time::timeout(
+        Duration::from_millis(500),
+        accept_and_ack_concurrent(
+            &packet("slow", 1, 1, now_ms(), PAYLOAD),
+            &ingress,
+            &replay,
+            |ack| Ok(ack.len()),
+        ),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert_eq!(ingress.metrics.get(Metric::EventsAccepted), 1);
+    assert_eq!(ingress.metrics.get(Metric::UdpAcksSent), 1);
+    drop(held);
+    while let Some(result) = tasks.join_next().await {
+        result.unwrap().unwrap();
+    }
+    assert_eq!(ingress.metrics.get(Metric::EventsAccepted), 2);
+    assert_eq!(ingress.metrics.get(Metric::UdpAcceptedDuplicates), 31);
+    assert_eq!(ingress.metrics.get(Metric::UdpAcksSent), 33);
+    assert!(replay.lock().unwrap().pending.is_empty());
+    ingress.events.stop_workers().await.unwrap();
+}
